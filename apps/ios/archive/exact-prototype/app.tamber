tamber chess

theme
  AccentColor = light-dark(#2f6bf5, #4a82ff)
  surface.ground = light-dark(#eeede9, #0c0c0b)
  surface.card = light-dark(#fffefc, #1d1c1b)
  surface.raised = light-dark(#f4f3ef, #2b2a28)
  surface.pressed = light-dark(#e8e6e1, #393734)
  ink = light-dark(#1d1c1a, #f6f4f0)
  ink.muted = light-dark(#8d8a84, #9c9890)
  ink.faint = light-dark(#cbc8c1, #4b4945)
  ink.fill = light-dark(#1d1c1a, #f6f4f0)
  ink.on-fill = light-dark(#fffefc, #1d1c1a)
  ink.on-accent = #ffffff  scheme=fixed
  accent.fill = light-dark(#2f6bf5, #3a74f7)
  accent.soft = light-dark(#2f6bf51f, #4a82ff33)
  shadow.card = light-dark(#5a4a3014, #00000000)
  shadow.accent = light-dark(#2f6bf540, #00000000)
  hairline = light-dark(#3a30200f, #ffffff14)
  status.live = #34c759  scheme=fixed
  board.light = light-dark(#f8f6f1, #4a4844)
  board.dark = light-dark(#e1ddd4, #34322f)
  board.coord.light = light-dark(#b7b1a5, #34322f)
  board.coord.dark = light-dark(#f8f6f1, #4a4844)
  board.select = light-dark(#2f6bf55c, #4a82ff70)
  board.last = light-dark(#2f6bf529, #4a82ff3d)
  board.check = light-dark(#ff3b3070, #ff453a8c)
  board.dot = light-dark(#1d1c1a2e, #ffffff3d)
  board.edge = light-dark(#1d1c1a12, #ffffff1a)

icons
  icon.laurel = icon(sf "laurel.leading", svg "icons/laurel.svg")
  icon.trophy = icon(sf "trophy.fill", svg "icons/trophy.svg")
  icon.crown = icon(sf "crown.fill", svg "icons/crown.svg")
  icon.puzzle = icon(sf "puzzlepiece.fill", svg "icons/puzzle.svg")
  icon.sun = icon(sf "sun.max.fill", svg "icons/sun.svg")
  icon.moon = icon(sf "moon.stars.fill", svg "icons/moon.svg")
  icon.contrast = icon(sf "circle.lefthalf.filled", svg "icons/contrast.svg")
  icon.flag = icon(sf "flag.fill", svg "icons/flag.svg")
  icon.chevron-down = icon(sf "chevron.down", svg "icons/chevron-down.svg")
  icon.arrow-left = icon(sf "arrow.left", svg "icons/arrow-left.svg")
  icon.haptics = icon(sf "iphone.radiowaves.left.and.right", svg "icons/haptics.svg")
  icon.board = icon(sf "checkerboard.rectangle", svg "icons/board.svg")
  icon.coords = icon(sf "textformat.abc", svg "icons/coords.svg")
  icon.feedback = icon(sf "bubble.left.fill", svg "icons/feedback.svg")
  icon.square = icon(sf "square.fill", svg "icons/square.svg")
  icon.circle = icon(sf "circle.fill", svg "icons/circle.svg")
  icon.seal = icon(sf "seal.fill", svg "icons/seal.svg")
  icon.bell = icon(sf "bell.badge.fill", svg "icons/bell.svg")
  icon.stats = icon(sf "chart.bar.fill", svg "icons/stats.svg")
  icon.gear = icon(sf "gearshape.fill", svg "icons/gear.svg")
  icon.dot = icon(sf "smallcircle.filled.circle", svg "icons/dot.svg")
