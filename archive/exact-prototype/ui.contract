// The app's own controls: round icon buttons, ink pills, choice rows, sheet headers.
// Every one is painted, so each is a `button` box of ours, not the platform's.

component IconButton
  props
    symbol: string
    label: string
    filled: bool
    press: action
    testId: string
  view
    button press=press aria-label=label testId=testId -exact-press-haptic="selection"
      width=52 height=52 border-radius=26 display="flex" align-items="center" justify-content="center"
      background-color=(filled ? "accent.fill" : "surface.card") color=(filled ? "ink.on-accent" : "ink")
      box-shadow=(filled ? "0 6px 16px shadow.accent" : "0 2px 10px shadow.card")
      image symbol font-size=19 font-weight=700 aria-hidden=true

component InkPill
  props
    label: string
    symbol: string
    press: action
    testId: string
  view
    button press=press testId=testId -exact-press-haptic="impact-light"
      display="flex" flex-direction="row" align-items="center" justify-content="center" gap=10
      height=56 padding="0 28px" border-radius=28 background-color="ink.fill" color="ink.on-fill"
      if symbol != ""
        image symbol font-size=18 aria-hidden=true
      text label font-size=19 font-weight=700

component SoftPill
  props
    label: string
    symbol: string
    press: action
    testId: string
  view
    button press=press testId=testId -exact-press-haptic="selection"
      display="flex" flex-direction="row" align-items="center" justify-content="center" gap=8
      height=48 padding="0 22px" border-radius=24 background-color="surface.raised" color="ink"
      if symbol != ""
        image symbol font-size=16 aria-hidden=true
      text label font-size=17 font-weight=600

component LevelOption
  props
    name: string
    symbol: string
    detail: string
    selected: bool
    press: action
    testId: string
  view
    button press=press role="radio" aria-checked=selected testId=testId -exact-press-haptic="selection"
      display="flex" flex-direction="column" align-items="stretch" gap=6 padding="16px 20px" border-radius=22
      background-color=(selected ? "ink.fill" : "surface.raised") color=(selected ? "ink.on-fill" : "ink")
      -exact-layout-transition="260ms ease"
      row align-items="center" gap=14
        image symbol font-size=17 aria-hidden=true opacity=(selected ? 1 : 0.45)
        text name font-size=20 font-weight=700 flex=1 text-align="start" opacity=(selected ? 1 : 0.55)
        if selected
          view width=26 height=26 border-radius=13 background-color="ink.on-fill" color="ink.fill"
            display="flex" align-items="center" justify-content="center"
            image "symbol:checkmark" font-size=13 font-weight=800 aria-hidden=true
      if selected
        text detail font-size=16 line-height=1.3 opacity=0.85 text-align="start"

component SheetHeader
  props
    title: string
    back: action
  view
    row align-items="center" gap=12 padding="8px 20px 4px 20px" min-height=64
      button press=back aria-label="Back" testId="sheet-back" -exact-press-haptic="selection"
        width=52 height=52 border-radius=26 background-color="surface.raised" color="ink"
        display="flex" align-items="center" justify-content="center" flex-shrink=0
        image "symbol:back" font-size=19 font-weight=700 aria-hidden=true
      text title role="heading" aria-level=1 font-size=28 font-weight=800 letter-spacing="-0.5px" flex=1 text-align="center"
      view width=52 flex-shrink=0

component SettingsRow
  props
    symbol: string
    title: string
    press: action
    testId: string
  view
    button press=press testId=testId -exact-press-haptic="selection"
      display="flex" flex-direction="row" align-items="center" gap=16 padding="20px 4px" color="ink"
      border-bottom="1px solid hairline"
      image symbol font-size=20 width=28 aria-hidden=true
      text title font-size=20 font-weight=700 flex=1 text-align="start"
      image "symbol:forward-chevron" font-size=15 color="ink.faint" aria-hidden=true

component SwitchRow
  props
    symbol: string
    title: string
    on: bool
    press: action
    testId: string
  view
    button press=press role="switch" aria-checked=on aria-label=title testId=testId -exact-press-haptic="selection"
      display="flex" flex-direction="row" align-items="center" gap=14 padding="16px 0" color="ink"
      image symbol font-size=19 width=26 aria-hidden=true
      text title font-size=19 font-weight=700 flex=1 text-align="start"
      view width=60 height=36 border-radius=18 padding=3 box-sizing="border-box" flex-shrink=0
        background-color=(on ? "ink.fill" : "surface.pressed") transition="background-color 200ms ease"
        view width=30 height=30 border-radius=15 background-color="surface.card"
          box-shadow="0 2px 6px shadow.card"
          translate=(on ? "24px 0px" : "0px 0px") transition="translate -exact-spring(420, 32, 1)"

component Chip
  props
    label: string
    selected: bool
    press: action
    testId: string
  view
    button press=press role="radio" aria-checked=selected testId=testId -exact-press-haptic="selection"
      display="flex" align-items="center" justify-content="center" height=44 padding="0 18px" border-radius=22
      background-color=(selected ? "ink.fill" : "surface.raised") color=(selected ? "ink.on-fill" : "ink")
      transition="background-color 160ms ease, color 160ms ease"
      text label font-size=16 font-weight=700

component DayCell
  props
    short: string
    number: string
    selected: bool
    marks: number
    future: bool
    press: action
    testId: string
  view
    button press=press disabled=future aria-label=`${short} ${number}` testId=testId -exact-press-haptic="selection"
      display="flex" flex-direction="column" align-items="center" gap=4 width=64 padding="12px 0 14px 0" border-radius=20
      background-color=(selected ? "surface.pressed" : "transparent") color="ink" opacity=(future ? 0.35 : 1)
      text short font-size=15 font-weight=600 color="ink.muted"
      text number font-size=26 font-weight=700 font-variant-numeric="tabular-nums"
      view width=24 height=24 border-radius=12 box-sizing="border-box" margin-top=2
        border-width=(marks == 0 ? 1.5 : 2.5) border-style=(marks == 0 ? "dashed" : "solid")
        border-color=(marks == 0 ? "ink.faint" : "accent.fill")
        background-color=(marks == 2 ? "accent.fill" : "transparent")
        display="flex" align-items="center" justify-content="center" color="ink.on-accent"
        if marks == 2
          image "symbol:checkmark" font-size=11 font-weight=800 aria-hidden=true
